# Splats are served same-origin via /r2/[[path]] Pages Function (SPLATS_R2 binding
# in wrangler.toml → bucket `foton`). This puts the Cloudflare edge cache in front
# of R2 — the public r2.dev URL is NOT cached at edge, which was the main load
# bottleneck. To bypass the proxy (e.g. debugging), set this to the bucket's
# pub-*.r2.dev URL (printed by `pnpm run r2:configure`).
VITE_PUBLIC_ASSETS_BASE=/r2

# Enlace "Editor" en el showroom (misma URL que el proyecto Pages foton-editor).
VITE_PUBLIC_EDITOR_URL=https://foton-editor.pages.dev

# Cache-bust for R2 splat assets. Bump this value (or set to current date) to
# force browsers/CDN to re-fetch .sog files after an R2 upload.
VITE_ASSET_CACHE_BUST=20260730
