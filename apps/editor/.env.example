# Same R2 public base as the viewer build (for dealership / splat fetches in deployed editor).
# VITE_PUBLIC_ASSETS_BASE=https://your-bucket-public-host.example

# Optional: URL opened by the ↗ button next to “Deploy to Cloudflare” (latest main / production editor on Pages).
# VITE_CF_PAGES_EDITOR_MAIN_URL=https://spark-viewer-editor.pages.dev

# When the showroom is deployed, point the editor at its origin (no trailing slash).
# VITE_VIEWER_API_ORIGIN=https://your-showroom.pages.dev
#
# If you use MANIFEST_SAVE_SECRET on the viewer API, set the same value here (cross-origin only).
# VITE_MANIFEST_SAVE_SECRET=
