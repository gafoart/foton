# Splats served through the viewer's same-origin /r2/* proxy (edge-cached).
# The editor runs on a different origin, so it uses the viewer's absolute URL.
# Alternative (direct, uncached): the bucket's pub-*.r2.dev URL printed by
# `pnpm run r2:configure`.
VITE_PUBLIC_ASSETS_BASE=https://foton-showroom.pages.dev/r2

# Showroom (Functions + /api/manifest). Must match the viewer's actual domain.
VITE_VIEWER_API_ORIGIN=https://foton-showroom.pages.dev
VITE_MANIFEST_SAVE_SECRET=iLkiaao9sdmj7fFSA3fKCSpjVrQCXYgsTIfPJwmVx0Q=
VITE_ASSET_CACHE_BUST=20260730
