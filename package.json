{
  "name": "changan-splat-showroom",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm -r --parallel run dev",
    "dev:viewer": "pnpm --filter viewer dev",
    "dev:editor": "pnpm --filter editor dev",
    "build": "pnpm -r run build",
    "build:viewer": "pnpm --filter viewer build",
    "build:editor": "pnpm --filter editor build",
    "lint": "pnpm -r run lint",
    "pages:deploy:viewer": "pnpm run build:viewer && bash scripts/pages-wrangler-deploy.sh viewer changan-showroom",
    "pages:create:editor": "pnpm --filter viewer exec wrangler pages project create spark-viewer-editor",
    "pages:deploy:editor": "pnpm run build:editor && bash scripts/pages-wrangler-deploy.sh editor spark-viewer-editor",
    "sync:splats:r2": "bash scripts/sync-splats-r2.sh",
    "r2:provision": "bash scripts/r2-provision.sh",
    "r2:configure": "R2_SKIP_BUCKET_ENSURE=1 bash scripts/r2-provision.sh",
    "r2:bootstrap": "bash scripts/r2-provision.sh && bash scripts/sync-splats-r2.sh",
    "r2:bootstrap:existing-bucket": "R2_SKIP_BUCKET_ENSURE=1 bash scripts/r2-provision.sh && bash scripts/sync-splats-r2.sh"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0"
}
